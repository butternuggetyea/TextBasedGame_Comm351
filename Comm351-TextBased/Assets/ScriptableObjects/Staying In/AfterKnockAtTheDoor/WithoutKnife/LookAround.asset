  m_Name: LookAround
  m_EditorClassIdentifier: Assembly-CSharp::GameStateData
  _senarioImage: {fileID: 21300000, guid: d92bcdc89c0763546ab715d9abe47570, type: 3}
  _forground: {fileID: 0}
  _soundclip: {fileID: 0}
  _playSoundIndex: 0
  _senarioDescription: 'You look intensely around the room analyzing every inch of
    it. Just as you were about to give up and lay down you caught a glimpse of something
    moving under your bed. Startled, you let out a gasp alerting the creature. Suddenly
    a tall black creature with a human-like body, slim in stature, but with a powerful
    aura arises from under your bed. Your flight or fight reflexes immediately kicking
    into high gear choosing flight as the default. You sprint out to the landing
    and quickly decide. Go into the study or go downstairs. '

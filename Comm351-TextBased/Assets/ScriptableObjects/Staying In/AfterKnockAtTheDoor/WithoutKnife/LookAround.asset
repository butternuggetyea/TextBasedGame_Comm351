  m_Name: LookAround
  m_EditorClassIdentifier: Assembly-CSharp::GameStateData
  _senarioImage: {fileID: 21300000, guid: 46172351de19d204e8e40b07cbe1343f, type: 3}
  _forground: {fileID: 0}
  _soundclip: {fileID: 0}
  _playSoundIndex: 0
  _senarioDescription: 'You walk around your room looking intensely for anything
    out of place. Last place to check is under your bed. Getting close to the bed,
    you bend over to take a look, but nothing is there. As you begin to walk away,
    a pure blackened, void-like hand reaches out and grabs your ankle. You shudder
    in fear as this creature crawls out from under the bed, approaches you, and towers
    over you. Slowly unhinging its jaw to reveal its mouth that looks like a portal
    to another dimension, framed by razor-sharp teeth. In one quick motion, this
    creature swallows you whole. (Not even the bones - Ending) '

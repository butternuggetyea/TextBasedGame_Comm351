  _soundclip: {fileID: 8300000, guid: dafe55f7d6f773a43bf8fbc71e627456, type: 3}
  _playSoundIndex: 135
  _senarioDescription: 'As you slowly creep up the stairs, you come to your landing,
    where you have to decide. Check your bedroom first or check the study first.
    *Creak* Before you could decide, you hear a noise from your bedroom. Slowly,
    you push open the door to your bedroom, which you are greeted by nothing. You
    think to yourself that it must have been the house settling, and that you need
    to relax. Should you lay down and try to relax or should you look around a little
    bit longer? '
  OptionAData: {fileID: 11400000, guid: b8477098822b0cf4d815267dcb9b9a7a, type: 2}
  OptionADescription: Relax
  OptionBData: {fileID: 11400000, guid: ab51bfe27cbbc2a43914a5b07608c9ee, type: 2}
  OptionBDescription: Look Around

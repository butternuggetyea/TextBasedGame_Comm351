  m_Name: Jump
  m_EditorClassIdentifier: Assembly-CSharp::GameStateData
  _senarioImage: {fileID: 21300000, guid: d2065951c2d3c674bb607be4c83f86b3, type: 3}
  _forground: {fileID: 0}
  _soundclip: {fileID: 0}
  _playSoundIndex: 0
  _senarioDescription: "You take the fall like a champ\u2026 besides the broken legs
    that leave you writhing in agony. As you let out your third scream from pain,
    your body gives out on you and you pass out in the yard. You awake to the sound
    of a plane flying overhead. You thought you would be dead for sure though your
    phone is still cut and you have no way of contacting help for your legs. Crawling
    to your vehicle you manage to get in and start the car. Your right leg is only
    fractured so you are barely able to drive. As you start to head out the driveway
    you see in the distance behind a tree, glowing eyes staring directly at you,
    then they disappear. You think to yourself that maybe it's time to move out.
    Parkour! - Ending "

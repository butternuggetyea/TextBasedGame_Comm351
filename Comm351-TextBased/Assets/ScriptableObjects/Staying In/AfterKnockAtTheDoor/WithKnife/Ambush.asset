  m_Script: {fileID: 11500000, guid: 2bcf558b34062c64797acaca0d6206e9, type: 3}
  m_Name: Ambush
  m_EditorClassIdentifier: Assembly-CSharp::GameStateData
  _senarioImage: {fileID: 21300000, guid: 13335d2492da72d42bfaeed7561fe0d0, type: 3}
  _forground: {fileID: 0}
  _soundclip: {fileID: 8300000, guid: 64c93b9a17014714fb561a7402f30830, type: 3}
  _playSoundIndex: 678
  _senarioDescription: "Deciding to ambush the creature, you leave your bedroom while
    exclaiming, \u201CI guess I'll take a look downstairs\u201D, then go to hide
    behind the study room door. After a few minutes of silence, you hear footsteps
    approaching. As you peek from behind the door, there you see a tall black creature
    with a human-like body, slim in stature, but with a powerful aura. This is a
    creature straight out of an eldritch horror film, and you are about to trick
    it successfully.  As it approaches the stairs, you see your window of opportunity
    and take it. In one quick and powerful motion, you swing open the door, smack
    the creature, stunning it just long enough for you to push it down the stairs.
    As the final thud of it smacking against the floor rings through the halls, so
    does a deafening scream."
